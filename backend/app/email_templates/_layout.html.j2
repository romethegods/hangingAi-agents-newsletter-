{#- Email-safe HTML: tables and inline styles only (Gmail/Outlook ignore <style> and flexbox). -#}
<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>{{ title }}</title></head>
<body style="margin:0;padding:0;background:#f3eee3;color:#171614;">
{% if preheader %}<div style="display:none;max-height:0;overflow:hidden;">{{ preheader }}</div>{% endif %}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#f3eee3;">
<tr><td align="center" style="padding:24px 12px;">
  <table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="max-width:600px;background:#fbf8f1;border:3px solid #171614;">
    <tr><td style="padding:22px 28px 14px;border-bottom:3px solid #171614;">
      <div style="font:11px/1.4 'Courier New',monospace;letter-spacing:1px;text-transform:uppercase;color:#5f5a50;">{{ kicker }}</div>
      <div style="font:900 34px/1.1 Georgia,'Times New Roman',serif;margin-top:6px;">Hanging<span style="color:#b93b1a;">Ai</span></div>
    </td></tr>
    {% block body %}{% endblock %}
    <tr><td style="padding:18px 28px;border-top:3px solid #171614;font:12px/1.6 Arial,Helvetica,sans-serif;color:#5f5a50;">
      {% block footer %}{% endblock %}
    </td></tr>
  </table>
</td></tr>
</table>
</body>
</html>
