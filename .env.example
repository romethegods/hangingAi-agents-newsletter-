# Copy to .env and fill in. Never commit .env.

# Local dev without Docker; docker-compose overrides this for its containers.
DATABASE_URL=postgresql+psycopg://hanging:hanging@localhost:5432/hanging
POSTGRES_PASSWORD=hanging

CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# Scraper
BROWSER_HEADLESS=true
BROWSER_MAX_TABS=3
SCRAPE_MIN_INTERVAL_SECONDS=2

# LLM enrichment (M2)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001

# Accounts, community & the daily brief
SITE_URL=https://hangingai.com
# REQUIRED in production: signs unsubscribe links. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Who can use /moderate (they must have added this email to their account)
ADMIN_EMAILS=["you@example.com"]
# "outbox" writes emails to backend/outbox/ (dev). "smtp" sends via any provider
# (Resend, Postmark, SES, Mailgun...).
EMAIL_BACKEND=outbox
EMAIL_FROM=HangingAi <brief@hangingai.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
