# Copy to .env and fill in. Never commit .env.

# --- Production (the VM): required by docker-compose.yml ---------------------------
SITE_DOMAIN=hangingai.com
ACME_EMAIL=you@example.com            # Let's Encrypt expiry notices
# Generate: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
# Generate: python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
BACKUP_BUCKET=                         # optional, e.g. gs://hangingai-backups

# Local dev without Docker; docker-compose sets this itself for its containers.
DATABASE_URL=postgresql+psycopg://hanging:hanging@localhost:5432/hanging

CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# Scraper
BROWSER_HEADLESS=true
BROWSER_MAX_TABS=3
SCRAPE_MIN_INTERVAL_SECONDS=2

# LLMs. Each key turns on that provider's Arena models:
#   ANTHROPIC_API_KEY -> Claude Haiku 4.5;  HF_TOKEN -> the open models via Hugging Face
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5
HF_TOKEN=

# Arena cost controls
ARENA_BATTLES_PER_DAY=20
ARENA_DAILY_BUDGET_USD=5
ARENA_MAX_OUTPUT_TOKENS=1024
# Free local stand-in models; on automatically when SITE_URL is localhost
# ARENA_DEV_MODELS=false

# Accounts, community & the daily brief
SITE_URL=https://hangingai.com
# REQUIRED in production: signs unsubscribe links. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Who can use /moderate (they must have added this email to their account)
ADMIN_EMAILS=["you@example.com"]
# "outbox" writes emails to backend/outbox/ (dev). "smtp" sends via any provider
# (Resend, Postmark, SES, Mailgun...).
EMAIL_BACKEND=outbox                   # production with Resend: smtp
EMAIL_FROM=HangingAi <brief@hangingai.com>
SMTP_HOST=                             # Resend: smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=                         # Resend: resend
SMTP_PASSWORD=                         # Resend: your API key (re_...)
