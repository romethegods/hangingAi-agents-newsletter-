# Copy to .env and fill in. Never commit .env.

# Local dev without Docker; docker-compose overrides this for its containers.
DATABASE_URL=postgresql+psycopg://hanging:hanging@localhost:5432/hanging
POSTGRES_PASSWORD=hanging

CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# Scraper
BROWSER_HEADLESS=true
BROWSER_MAX_TABS=3
SCRAPE_MIN_INTERVAL_SECONDS=2

# LLM enrichment (M2)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-4-5-20251001
